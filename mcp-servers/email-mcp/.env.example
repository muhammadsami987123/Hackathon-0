# Email MCP Server Configuration
# Copy this file to .env and update with your actual credentials

# Email account settings
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password

# SMTP settings (Gmail defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# For other email providers, adjust these:
# Outlook: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
# Yahoo: SMTP_HOST=smtp.mail.yahoo.com, SMTP_PORT=587